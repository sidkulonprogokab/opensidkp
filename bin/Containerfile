FROM serversideup/php:8.1-fpm-nginx-alpine-v3.0.0 AS base

# Switch to root to install dependencies and copy files
USER root

RUN apk add --no-cache tzdata

# Install PHP dependencies
RUN install-php-extensions gd \
        exif \
        mysqli \
        tidy

COPY --chown=www-data:www-data . /var/www/html/public

COPY --chown=www-data:www-data ./bin/nginx/custom-opensid.conf /etc/nginx/server-opts.d/custom-opensid.conf

# Switch back to non-root user for security
USER www-data
